<?xml version="1.0" encoding="utf-8"?>
<Weavers xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="FodyWeavers.xsd">
  <!-- Embed every Copy Local managed dependency. Assemblies are extracted to
       Costura's temporary directory when loaded so libraries that require a
       physical Assembly.Location (for example WPF themes) remain compatible. -->
  <Costura CreateTemporaryAssemblies="true">
    <!-- This application is x86-only. Embed all x86 native dependencies that
         can be loaded normally; the PureDM COM registration files under libs
         remain external because Windows must register/load them by file path. -->
    <UnmanagedWinX86Assemblies>
      Magick.Native-Q16-x86
      cvextern
      libusb-1.0
      opencv_videoio_ffmpeg4130
      concrt140
      msvcp140
      msvcp140_1
      msvcp140_2
      msvcp140_atomic_wait
      msvcp140_codecvt_ids
      vcruntime140
    </UnmanagedWinX86Assemblies>
  </Costura>
</Weavers>

