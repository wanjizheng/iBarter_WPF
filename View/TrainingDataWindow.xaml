<Syncfusion:ChromelessWindow x:Class="iBarter.View.TrainingDataWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             xmlns:local="clr-namespace:iBarter.View"
                             xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
                             xmlns:collections="clr-namespace:System.Collections;assembly=System.Runtime"
                             mc:Ignorable="d"
                             Icon="/Images/scan.png"
                             TitleBarBackground="{Binding TitleBarBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TitleBarForeground="{Binding TitleBarForeground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             CloseButtonTemplate="{DynamicResource ProductsWindowCloseButtonTemplate}"
                             MaximizeButtonTemplate="{DynamicResource ProductsWindowMaximizeButtonTemplate}"
                             MinimizeButtonTemplate="{DynamicResource ProductsWindowMinimizeButtonTemplate}"
                             ResizeBorderThickness="0"
                             RestoreButtonTemplate="{DynamicResource ProductsWindowRestoreButtonTemplate}"
                             Title="OCR Training Data Labeler" Height="700" Width="1100">
    <Syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/WindowStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Syncfusion:ChromelessWindow.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top: progress + path -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Source: " VerticalAlignment="Center" />
                <TextBox x:Name="TextBox_SourceDir" Width="500" VerticalAlignment="Center"
                         Text="C:\Users\wanjizheng\MyProject\iBarter\bin\x86\Debug\net10.0-windows10.0.26100.0\win-x86\Resources"
                         IsReadOnly="True" />
                <Button x:Name="Button_Reload" Content="Reload" Margin="6,0,0,0" Padding="12,4"
                        Click="Button_Reload_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Progress: " VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock x:Name="TextBlock_Progress" VerticalAlignment="Center" Text="0 / 0 labeled" />
                <ProgressBar x:Name="ProgressBar_Labeled" Width="300" Height="14" Margin="10,0,0,0" Minimum="0" Maximum="100" Value="0" />
                <TextBlock x:Name="TextBlock_Threshold" VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="(need >= 30 to train)" Foreground="DarkOrange" />
            </StackPanel>
        </StackPanel>

        <!-- Middle: left list + right viewer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: file list -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                        <TextBlock Text="Files: " VerticalAlignment="Center" />
                        <TextBlock x:Name="TextBlock_FileCount" VerticalAlignment="Center" Text="0" />
                    </StackPanel>
                    <ListBox x:Name="ListBox_Files" Grid.Row="1"
                             SelectionChanged="ListBox_Files_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Status}" Width="14" FontWeight="Bold" />
                                    <TextBlock Text="{Binding FileName}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: image + label -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Current: " FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TextBlock_CurrentFile" VerticalAlignment="Center" />
                        <TextBlock Text="  |  Size: " Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TextBlock_CurrentSize" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Margin="0,8" Background="White">
                        <Image x:Name="Image_Current" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="Label (1-4 digits): " VerticalAlignment="Center" FontWeight="Bold" />
                        <TextBox x:Name="TextBox_Label" Width="120" FontSize="16" Padding="6,4"
                                 KeyDown="TextBox_Label_KeyDown" />
                        <Button x:Name="Button_Save" Content="Save &amp; Next" Margin="8,0,0,0" Padding="12,6"
                                Click="Button_Save_Click" IsDefault="True" />
                        <Button x:Name="Button_Skip" Content="Skip" Margin="4,0,0,0" Padding="12,6"
                                Click="Button_Skip_Click" />
                        <Button x:Name="Button_Prev" Content="Previous" Margin="4,0,0,0" Padding="12,6"
                                Click="Button_Prev_Click" />
                        <Button x:Name="Button_Reveal" Content="Open Folder" Margin="4,0,0,0" Padding="12,6"
                                Click="Button_Reveal_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <TextBlock x:Name="TextBlock_Status" VerticalAlignment="Center" Foreground="DarkGreen" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom: export + train -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="0,8,0,0" Padding="8">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Export &amp; Train: " VerticalAlignment="Center" FontWeight="Bold" />
                    <Button x:Name="Button_Export" Content="1. Generate train.lstmf" Margin="10,0,0,0" Padding="12,6"
                            Click="Button_Export_Click" />
                    <Button x:Name="Button_CopyCmd" Content="2. Copy tesstrain command" Margin="4,0,0,0" Padding="12,6"
                            Click="Button_CopyCmd_Click" />
                </StackPanel>
                <TextBlock x:Name="TextBlock_ExportStatus" Margin="0,6,0,0" Foreground="DarkGreen" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Syncfusion:ChromelessWindow>