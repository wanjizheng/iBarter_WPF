<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:iBarter.View"
    xmlns:domain="clr-namespace:iBarter"
    xmlns:vm="clr-namespace:iBarter.ViewModel"
    xmlns:controls="clr-namespace:iBarter.Controls"
    xmlns:loc="clr-namespace:iBarter.Localization"
    xmlns:Syncfusion="http://schemas.syncfusion.com/wpf" x:Class="iBarter.View.ShipCargoControl"
    xmlns:Syncfusion1="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
    mc:Ignorable="d"
    d:DesignHeight="850" d:DesignWidth="300">
    <Control.Resources>
        <DataTemplate DataType="{x:Type domain:Barter}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding IsLandNameDisplay, StringFormat='{}{0}: '}" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalItem1ExchangeQuantity, StringFormat='[{0}]'}" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Image Source="{Binding Item1Icon}" />
                <TextBlock Text=" => " FontWeight="Bold" VerticalAlignment="Center" />
                <Image Source="{Binding Item2Icon}" />
                <TextBlock Text="{Binding TotalItem2ExchangeQuantity, StringFormat='[{0}]'}" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <StackPanel.ToolTip>
                    <ToolTip>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Item1NameDisplay}" FontWeight="Bold" FontStyle="Italic" />
                            <TextBlock Text=" => " FontWeight="Bold" FontStyle="Italic" />
                            <TextBlock Text="{Binding Item2NameDisplay}" FontWeight="Bold" FontStyle="Italic" />
                        </StackPanel>
                    </ToolTip>
                </StackPanel.ToolTip>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WarehouseRouteStepViewModel}">
            <Border Padding="7" Margin="3,2" Background="#223B5B" BorderBrush="#416C94" BorderThickness="1" CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#FFD166" />
                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" ToolTip="{Binding DisplayName}">
                                    <Image Source="{Binding Icon}" Width="24" Height="24" />
                                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Foreground="White">
                                        <Run Text="{Binding DisplayName}" />
                                        <Run Text=" × " />
                                        <Run Text="{Binding Quantity}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LoadText}" Margin="0,3,0,0" FontFamily="Consolas" Foreground="#9ED8FF" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BarterRouteStepViewModel}">
            <Border Padding="7" Margin="3,2" CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#182532" />
                        <Setter Property="BorderBrush" Value="#2D4355" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         Value="True">
                                <Setter Property="Background" Value="#49351B35" />
                                <Setter Property="BorderBrush" Value="#FFFF4FA3" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Title}" Margin="0,0,70,0"
                                   FontWeight="Bold" Foreground="White" />
                        <Border HorizontalAlignment="Right" Padding="5,1" CornerRadius="2"
                                Background="#FFFF4FA3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{loc:Localize str.ShipCargo.CurrentSelection}"
                                       Foreground="#20101B" FontWeight="Bold" FontSize="10" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                        <Image Source="{Binding Item1Icon}" Width="24" Height="24" />
                        <TextBlock Text="{Binding Detail}" Margin="6,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="White" />
                        <Image Source="{Binding Item2Icon}" Width="24" Height="24" />
                    </StackPanel>
                    <TextBlock Text="{Binding LoadText}" Margin="0,3,0,0" FontFamily="Consolas" Foreground="#9ED8FF" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style TargetType="Syncfusion:PropertyGrid" x:Key="PropertyStyle">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="ViewBackgroundColor" Value="White" />
        </Style>

    </Control.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=" Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>
        <Syncfusion:ToolBarAdv x:Name="ToolBarAdv_Planner" Grid.Row="0">
            <StackPanel x:Name="Panel_AutomaticRouteSelector" Margin="6,0" VerticalAlignment="Center" Visibility="Visible">
                <TextBlock Text="{loc:Localize str.ShipCargo.AutoRoute.Selector}" FontSize="10" Foreground="#5B7184" />
                <ComboBox x:Name="ComboBoxAdv_RouteSelector" Width="126"
                          IsEnabled="False"
                          ItemsSource="{Binding RouteOptions}" DisplayMemberPath="DisplayName"
                          SelectionChanged="ComboBoxAdv_RouteSelector_SelectionChanged" />
            </StackPanel>
            <Separator />
            <controls:FluentIconButton x:Name="ButtonAdv_Clean" IconData="{StaticResource FluentIcon.Delete}"
                Label="{loc:Localize str.ShipCargo.Btn.Clean}" ToolTip="{loc:Localize str.ShipCargo.Btn.CleanTip}" Click="ButtonAdv_Clean_Click" />
        </Syncfusion:ToolBarAdv>
        <ListBox x:Name="ListBox_ShipCargo" Grid.Row="1" Background="#101B26" BorderThickness="0"
                 AllowDrop="True" ScrollViewer.CanContentScroll="True" SelectionMode="Single"
                 PreviewMouseWheel="ListBox_ShipCargo_PreviewMouseWheel"
                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown" Drop="ListBox_Drop">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AllowDrop" Value="True" />
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_MouseLeftButtonDown" />
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_MouseRightButtonDown" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <Syncfusion:SfGridSplitter Height="2" Grid.Row="2" HorizontalAlignment="Stretch"
                                   VerticalAlignment="Top"
                                   EnableCollapseButton="True"
                                   ResizeBehavior="PreviousAndNext"
                                   ShowsPreview="True" />
        <Grid Grid.Row="3">
            <Syncfusion:PropertyGrid x:Name="PropertyGrid_Ship" Style="{StaticResource PropertyStyle}">

            </Syncfusion:PropertyGrid>
        </Grid>
        <!-- <Syncfusion:SfGridSplitter  Margin="0,0,0,0" Grid.Row="1" VerticalAlignment="Center"/> -->

    </Grid>
</UserControl>
