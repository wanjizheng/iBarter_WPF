<Syncfusion:ChromelessWindow x:Class="iBarter.View.StorageManagement"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             xmlns:local="clr-namespace:iBarter.View"
                             xmlns:loc="clr-namespace:iBarter.Localization"
                             xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
                             xmlns:Syncfusion1="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
                             xmlns:collections="clr-namespace:System.Collections;assembly=System.Runtime"
                             mc:Ignorable="d"
                             Icon="/Images/storage.png"
                             TitleBarBackground="{Binding TitleBarBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TitleBarForeground="{Binding TitleBarForeground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             CloseButtonTemplate="{DynamicResource ProductsWindowCloseButtonTemplate}"
                             MaximizeButtonTemplate="{DynamicResource ProductsWindowMaximizeButtonTemplate}"
                             MinimizeButtonTemplate="{DynamicResource ProductsWindowMinimizeButtonTemplate}"
                             ResizeBorderThickness="0"
                             RestoreButtonTemplate="{DynamicResource ProductsWindowRestoreButtonTemplate}"
                             Title="{loc:Localize str.Menu.StorageManager}" Height="450" Width="800"
                             FontFamily="{StaticResource AppFontFamily}"
                             TextOptions.TextFormattingMode="Display"
                             TextOptions.TextRenderingMode="ClearType">
    <Syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/WindowStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Syncfusion:ChromelessWindow.Resources>
    <Syncfusion:ChromelessWindow.RightHeaderItemsSource>
        <collections:ArrayList>
            <ToggleButton x:Name="PinWindow"
                          Template="{StaticResource ThemeButton}"
                          IsChecked="False"
                          Visibility="Visible"
                          Margin="0,0,12,0"
                          Padding="7,4,12,4"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" Click="PinWindow_Click">
                <ToggleButton.Content>
                    <Viewbox Height="16" Width="16"><Path Data="{StaticResource FluentIcon.Pin}"
                        Fill="{Binding TitleBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" /></Viewbox>
                </ToggleButton.Content>
                <ToggleButton.Style>
                    <Style TargetType="{x:Type ToggleButton}">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </collections:ArrayList>
    </Syncfusion:ChromelessWindow.RightHeaderItemsSource>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <Style
                    x:Key="alternatingRowStyle"
                    
                    TargetType="Syncfusion1:VirtualizingCellsControl">
                    <Setter Property="Background" Value="LightGray" />
                </Style>
                <Style
                    x:Key="rowStyle"
                    
                    TargetType="Syncfusion1:VirtualizingCellsControl">
                    <Setter Property="Background" Value="White" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Syncfusion:ToolBarAdv x:Name="ToolBarAdv_Planner" Grid.Row="0"><Label Content="{loc:Localize str.Storage.DefaultSeedCity}" />
            <Syncfusion:ComboBoxAdv x:Name="ComboBoxAdv_DefaultStorage" SelectedIndex="1" >
                <Syncfusion:ComboBoxItemAdv Content="{loc:Localize str.Grid.Storage.Col.Velia}" />
                <Syncfusion:ComboBoxItemAdv Content="{loc:Localize str.Grid.Storage.Col.Iliya}" />
                <Syncfusion:ComboBoxItemAdv Content="{loc:Localize str.Grid.Storage.Col.Epheria}" />
                <Syncfusion:ComboBoxItemAdv Content="{loc:Localize str.Grid.Storage.Col.Ancado}" />
            </Syncfusion:ComboBoxAdv>
        </Syncfusion:ToolBarAdv>
        <Syncfusion:SfDataGrid x:Name="DataGrid_Storage" Height="NaN" Width="NaN" AutoGenerateColumns="False"
                               AllowEditing="True"
                               ColumnSizer="AutoWithLastColumnFill"
                               RowSelectionBrush="DarkBlue"
                               SelectionForegroundBrush="Bisque"
                               AllowDraggingRows="True"
                               ShowRowHeader="True"
                               AlternatingRowStyle="{StaticResource alternatingRowStyle}"
                               RowStyle="{StaticResource rowStyle}"
                               AllowDrop="False" LiveDataUpdateMode="AllowChildViewUpdate" AllowSorting="False" CurrentCellEndEdit="DataGrid_Storage_CurrentCellEndEdit" Grid.Row="1">
            <Syncfusion:SfDataGrid.Columns>
                <Syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Storage.Col.Inventory}" MappingName="ItemNameDisplay" AllowResizing="True"
                                   AllowEditing="False" ColumnSizer="Auto"/>
                <Syncfusion:GridImageColumn HeaderText="{loc:Localize str.Grid.Storage.Col.Icon}" MappingName="ItemIcon" Width="40"
                                    TextAlignment="Center" AllowEditing="False" />
                <Syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Storage.Col.Tier}" Width="70" MappingName="ItemTierDisplay"
                                   AllowEditing="False" AllowResizing="True"/>
                <Syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Storage.Col.Velia}" MappingName="StorageVeliaQuantity_Velia"
                                           AllowEditing="True" AllowResizing="True"/>
                <Syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Storage.Col.Iliya}" MappingName="StorageVeliaQuantity_Iliya"
                                           AllowEditing="True" AllowResizing="True"/>
                <Syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Storage.Col.Epheria}" MappingName="StorageVeliaQuantity_Epheria"
                                           AllowEditing="True" AllowResizing="True"/>
                <Syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Storage.Col.Ancado}" MappingName="StorageVeliaQuantity_Ancado"
                                           AllowEditing="True" AllowResizing="True"/>
            </Syncfusion:SfDataGrid.Columns>

        </Syncfusion:SfDataGrid>
    </Grid>
</Syncfusion:ChromelessWindow>
