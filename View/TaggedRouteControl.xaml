<UserControl x:Class="iBarter.View.TaggedRouteControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/iBarter;component/Resources/Styles/TaggedControls.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource AppSurfaceBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <DockPanel Margin="6">
    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Padding="8,3" Click="Settings_Click"/>
    <CheckBox x:Name="EnabledBox" VerticalAlignment="Center" Click="Enabled_Changed" Foreground="{DynamicResource AppTextBrush}"/>
   </DockPanel>
   <TextBlock x:Name="StatusText" Margin="8,0,8,6" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}">
    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </StackPanel>
  <WrapPanel x:Name="ActionsPanel" Grid.Row="1" Margin="5" Visibility="Collapsed">
   <Button x:Name="NextButton" Margin="2" Padding="8,4" Click="Next_Click"/>
   <Button x:Name="UndoButton" Margin="2" Padding="8,4" Click="Undo_Click"/>
   <Button x:Name="ReplanButton" Margin="2" Padding="8,4" Click="Replan_Click"/>
   <Button x:Name="SettleButton" Margin="2" Padding="8,4" Click="Settle_Click"/>
   <Button x:Name="CancelButton" Margin="2" Padding="8,4" Click="Cancel_Click" Visibility="Collapsed"/>
  </WrapPanel>
  <DockPanel x:Name="PlanPanel" Grid.Row="2" Visibility="Collapsed" Margin="4">
    <StackPanel DockPanel.Dock="Top" Margin="6">
     <TextBlock x:Name="ExecutionHelp" Visibility="Collapsed"/>
     <TextBlock x:Name="RouteCountText" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,4"/>
     <ComboBox x:Name="RouteSelector" DisplayMemberPath="DisplayName" SelectionChanged="RouteSelector_SelectionChanged"/>
     <CheckBox x:Name="GuidesBox" Margin="0,6,0,0" Foreground="{DynamicResource AppTextBrush}" Checked="Guides_Changed" Unchecked="Guides_Changed"/>
    </StackPanel>
    <ListBox x:Name="StepsList" BorderThickness="0" Background="{DynamicResource AppRaisedSurfaceBrush}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="StepsList_SelectionChanged">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Step_MouseLeftButtonDown"/>
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="Step_MouseRightButtonDown"/>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
      <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" Margin="8,12,8,4" Foreground="{DynamicResource AppAccentBrush}"/>
     </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Border Padding="7" Margin="3,2" CornerRadius="3" Opacity="{Binding Opacity}">
       <Border.Style><Style TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
         <Setter Property="Background" Value="{DynamicResource AppRaisedSurfaceBrush}"/>
         <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
         <Setter Property="BorderThickness" Value="2"/>
        </DataTrigger></Style.Triggers>
       </Style></Border.Style>
       <StackPanel>
        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}"/>
        <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}">
         <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCargoGroup}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         <InlineUIContainer BaselineAlignment="Center"><Image Source="{Binding Item1Icon}" Width="24" Height="24" Margin="0,0,5,0"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Item1Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></InlineUIContainer>
         <Run Text="{Binding Detail}"/>
         <InlineUIContainer BaselineAlignment="Center"><Image Source="{Binding Item2Icon}" Width="24" Height="24" Margin="5,0,0,0"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Item2Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></InlineUIContainer>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,0">
         <ItemsControl.ItemTemplate><DataTemplate>
          <Grid Margin="0,3">
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,6,0"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}"><Run Text="{Binding BeforeCharacter, Mode=OneWay}"/><Run Text="{Binding CharacterText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/><Run Text="{Binding AfterCharacter, Mode=OneWay}"/></TextBlock>
          </Grid>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Load}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}"/>
       </StackPanel>
      </Border>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
 </Grid>
</UserControl>
