<syncfusion:ChromelessWindow xmlns:syncfusion="http://schemas.syncfusion.com/wpf" x:Name="BarterScanner1"
                             x:Class="iBarter.View.BarterScanner"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             xmlns:local="clr-namespace:iBarter"
             xmlns:loc="clr-namespace:iBarter.Localization"
                             xmlns:collections="clr-namespace:System.Collections;assembly=System.Runtime"
                             mc:Ignorable="d"
                             AllowsTransparency="True" WindowStyle="None"
                             Icon="/Images/barter.png"
                             TitleBarBackground="{Binding TitleBarBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TitleBarForeground="{Binding TitleBarForeground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             CloseButtonTemplate="{DynamicResource ProductsWindowCloseButtonTemplate}"
                             MaximizeButtonTemplate="{DynamicResource ProductsWindowMaximizeButtonTemplate}"
                             MinimizeButtonTemplate="{DynamicResource ProductsWindowMinimizeButtonTemplate}"
                             ResizeBorderThickness="0"
                             RestoreButtonTemplate="{DynamicResource ProductsWindowRestoreButtonTemplate}"
                             Title="BarterScanner" Height="350" Width="750">
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/WindowStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    <syncfusion:ChromelessWindow.RightHeaderItemsSource>
        <collections:ArrayList>
            <ToggleButton x:Name="PinWindow"
                      Template="{StaticResource ThemeButton}"
                      IsChecked="False"
                      Visibility="Visible"
                      Margin="0,0,12,0"
                      Padding="7,4,12,4"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center" Click="PinWindow_Click">
                <ToggleButton.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/pin.png" Height="15" Width="15"></Image>
                    </StackPanel>
                </ToggleButton.Content>
                <ToggleButton.Style>
                    <Style TargetType="{x:Type ToggleButton}">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </collections:ArrayList>
    </syncfusion:ChromelessWindow.RightHeaderItemsSource>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="749*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2">
            <syncfusion:ToolBarAdv x:Name="ScannerToolBar">
                <syncfusion:ButtonAdv
                    Name="ButtonAdv_Scan"
                    Margin="4,0,4,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IconWidth="26" IconHeight="26"
                    Label="{loc:Localize str.Scanner.Btn.Scan}"
                    ToolTip="{loc:Localize str.Scanner.Btn.ScanTip}"
                    SizeMode="Small"
                    FontFamily="Microsoft YaHei"
                    SmallIcon="/Images/scan.png" Click="ButtonAdv_Scan_ClickAsync" />
                <syncfusion:ButtonAdv
                    Name="ButtonAdv_Add"
                    Margin="4,0,4,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IconWidth="26" IconHeight="26"
                    Label="{loc:Localize str.Scanner.Btn.Add}"
                    ToolTip="{loc:Localize str.Scanner.Btn.AddTip}"
                    SizeMode="Small"
                    FontFamily="Microsoft YaHei"
                    SmallIcon="/Images/add.png" Click="ButtonAdv_Add_Click" />
            </syncfusion:ToolBarAdv>

            <syncfusion:SfDataGrid x:Name="BarterScanResults" Height="NaN" Width="NaN" AutoGenerateColumns="False"
                                   AllowEditing="True"
                                   ColumnSizer="AutoWithLastColumnFill"
                                   RowSelectionBrush="DarkBlue"
                                   SelectionForegroundBrush="Bisque"
                                   AllowDraggingRows="False"
                                   ShowRowHeader="True"
                                   AllowDrop="True" LiveDataUpdateMode="AllowDataShaping"
                                   CurrentCellEndEdit="BarterScanResults_CurrentCellEndEdit"
                                   CurrentCellDropDownSelectionChanged="BarterScanResults_CurrentCellDropDownSelectionChanged">
                <syncfusion:SfDataGrid.Columns>
                    <!-- <syncfusion:GridTextColumn HeaderText="Island1" MappingName="IsLandName" UseBindingValue="True" -->
                    <!--                            AllowResizing="True" AllowEditing="True"> -->
                    <!-- </syncfusion:GridTextColumn> -->

                    <syncfusion:GridMultiColumnDropDownList x:Name="GridMultiColumnDropDownList_Islands"
                                                            AllowAutoComplete="True"
                                                            AutoGenerateColumns="False"
                                                            DisplayMember="IslandsNameDisplay"
                                                            HeaderText="{loc:Localize str.Grid.Scanner.Col.IslandsSub}"
                                                            MappingName="IsLandName"
                                                            ValueMember="IslandsName"
                                                            AllowResizing="True"
                                                            AllowIncrementalFiltering="True" AllowEditing="True"
                                                            SearchCondition="Contains">
                        <syncfusion:GridMultiColumnDropDownList.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsLandNameDisplay}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridMultiColumnDropDownList.CellTemplate>
                        <syncfusion:GridMultiColumnDropDownList.Columns>
                            <syncfusion:Columns>
                                <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.IslandsSub}" MappingName="IslandsNameDisplay" />
                                <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.Parley}" MappingName="Parley" />
                                <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.Remaining}" MappingName="Remaining" />
                            </syncfusion:Columns>
                        </syncfusion:GridMultiColumnDropDownList.Columns>
                    </syncfusion:GridMultiColumnDropDownList>


                    <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.No}" MappingName="IslandRemaining" AllowResizing="True"
                                               AllowEditing="True">
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.Parley}" MappingName="Parley" AllowResizing="True"
                                               AllowEditing="True">
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.I1No}" Width="60" MappingName="Item1Number"
                                               AllowEditing="True" AllowResizing="True">
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridImageColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.Icon1}" MappingName="Item1Icon" Width="40"
                                                TextAlignment="Center" AllowEditing="True" />
                    <syncfusion:GridMultiColumnDropDownList x:Name="GridMultiColumnDropDownList_Item1"
                                                            AllowAutoComplete="True"
                                                            AutoGenerateColumns="False"
                                                            DisplayMember="ItemNameDisplay"
                                                            HeaderText="{loc:Localize str.Grid.Scanner.Col.Item1Name}"
                                                            MappingName="Item1Name"
                                                            ValueMember="ItemName"
                                                            AllowResizing="True"
                                                            AllowIncrementalFiltering="True" AllowEditing="True"
                                                            AllowFiltering="True"
                                                            SearchCondition="Contains">
                        <syncfusion:GridMultiColumnDropDownList.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Item1NameDisplay}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridMultiColumnDropDownList.CellTemplate>
                        <syncfusion:GridMultiColumnDropDownList.Columns>
                            <syncfusion:Columns>
                                <syncfusion:GridTextColumn
                                    HeaderText="{loc:Localize str.Grid.Scanner.Col.DropdownItemID}"
                                    MappingName="ItemID" />
                                <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.DropdownItemName}" MappingName="ItemNameDisplay" />
                                <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.DropdownItemLV}" MappingName="ItemLV" />
                                <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.DropdownItemNumber}" MappingName="ItemNumber" />
                            </syncfusion:Columns>
                        </syncfusion:GridMultiColumnDropDownList.Columns>
                    </syncfusion:GridMultiColumnDropDownList>


                    <!-- <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.Item1Name}" MappingName="Item1Name" AllowEditing="True" AllowResizing="True"></syncfusion:GridTextColumn> -->
                    <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.I2No}" Width="60" MappingName="Item2Number"
                                               AllowEditing="True" AllowResizing="True">
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridImageColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.Icon1}" MappingName="Item2Icon" TextAlignment="Center"
                                                Width="42">
                    </syncfusion:GridImageColumn>
                    <syncfusion:GridMultiColumnDropDownList x:Name="GridMultiColumnDropDownList_Item2"
                                                            AllowAutoComplete="True"
                                                            AutoGenerateColumns="False"
                                                            DisplayMember="ItemNameDisplay"
                                                            HeaderText="{loc:Localize str.Grid.Scanner.Col.Item2Name}"
                                                            MappingName="Item2Name"
                                                            ValueMember="ItemName"
                                                            AllowResizing="True"
                                                            AllowIncrementalFiltering="True" AllowEditing="True"
                                                            AllowFiltering="True"
                                                            SearchCondition="Contains">
                        <syncfusion:GridMultiColumnDropDownList.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Item2NameDisplay}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridMultiColumnDropDownList.CellTemplate>
                        <syncfusion:GridMultiColumnDropDownList.Columns>
                            <syncfusion:Columns>
                                <syncfusion:GridTextColumn
                                    HeaderText="{loc:Localize str.Grid.Scanner.Col.DropdownItemID}"
                                    MappingName="ItemID" AllowSorting="True" />
                                <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.DropdownItemName}" MappingName="ItemNameDisplay"
                                                           AllowSorting="True" />
                                <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.DropdownItemLV}" MappingName="ItemLV"
                                                           AllowSorting="True" />
                                <syncfusion:GridTextColumn HeaderText="{loc:Localize str.Grid.Scanner.Col.DropdownItemNumber}" MappingName="ItemNumber"
                                                           AllowSorting="True" />
                            </syncfusion:Columns>
                        </syncfusion:GridMultiColumnDropDownList.Columns>
                    </syncfusion:GridMultiColumnDropDownList>


                </syncfusion:SfDataGrid.Columns>

            </syncfusion:SfDataGrid>
            <!-- <CheckBox Content="UseNativeChrome"   x:Name="usenativechrome" /> -->
            <!--  <StackPanel Orientation="Horizontal"> -->
            <!--         <TextBlock Text="Set Corner Radius"/> -->
            <!--         <Slider x:Name="cornerradius" Orientation="Horizontal" Value="20" Ticks="0.5" Minimum="0" Maximum="200" Width="200"  ></Slider> -->
            <!--     </StackPanel> -->
            <!-- <StackPanel> -->
            <!--     <TextBlock Text="set TitleBar Background"/> -->
            <!--     <syncfusion:ColorPicker x:Name="background" /> -->
            <!-- </StackPanel> -->

        </StackPanel>
    </Grid>
</syncfusion:ChromelessWindow>
