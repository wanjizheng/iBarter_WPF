    <system:String x:Key="str.Menu.BarterScanner">Barter Scanner</system:String>
    <system:String x:Key="str.Menu.StorageManager">Storage Manager</system:String>
    <system:String x:Key="str.Menu.SyncImages">Sync Images</system:String>

