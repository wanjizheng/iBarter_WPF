<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        iBarter English (default) UI strings.

        Key convention:  str.<Area>.<SubArea>.<Key>  dot-separated.
        Areas (Phase 2): Menu / Dock / MainWindow / Splash / Banner /
                         Planner / Storage / Scanner / ShipCargo / Grid.<View>.

        Phase 2 adds the UI chrome (menus, docks, buttons, tooltips,
        column headers). Phase 3 fills Strings.zh-TW.xaml with real
        translations; Phase 5+ add tier/label/log strings.

        A single "placeholder" key from Phase 1 is preserved so the
        live switch plumbing can still be sanity-checked.
    -->

    <!-- Phase 1 sanity-check key (intentionally kept) -->
    <system:String x:Key="str.i18n.placeholder">i18n scaffolding active (en-US)</system:String>

    <!-- MainWindow.xaml -->
    <system:String x:Key="str.MainWindow.Title">iBarter</system:String>
    <system:String x:Key="str.MainWindow.ThemesToggle">Themes</system:String>
    <system:String x:Key="str.MainWindow.ThemesPanelHeader">Themes</system:String>
    <system:String x:Key="str.MainWindow.ChoosePalette">Choose Palette</system:String>

    <!-- Top menu (MainWindow.xaml) -->
