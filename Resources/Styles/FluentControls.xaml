    <Style TargetType="{x:Type controls:FluentIconButton}">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinWidth" Value="54" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FluentIconButton}">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}" CornerRadius="6"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Viewbox Width="22" Height="22" Stretch="Uniform">
                                <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding Foreground}" />
                            </Viewbox>
                            <TextBlock Margin="0,2,0,0" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}" Text="{TemplateBinding Label}"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppRaisedSurfaceBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#E5A84B" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(skinManager:SfSkinManager.Theme).ThemeName, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Windows11Dark">
                <Setter Property="Foreground" Value="#E7EEF2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(skinManager:SfSkinManager.Theme).ThemeName, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="FluentDark">
                <Setter Property="Foreground" Value="#E7EEF2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(skinManager:SfSkinManager.Theme).ThemeName, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="MaterialDark">
                <Setter Property="Foreground" Value="#E7EEF2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(skinManager:SfSkinManager.Theme).ThemeName, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="MaterialDarkBlue">
                <Setter Property="Foreground" Value="#E7EEF2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(skinManager:SfSkinManager.Theme).ThemeName, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Office2019Black">
                <Setter Property="Foreground" Value="#E7EEF2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(skinManager:SfSkinManager.Theme).ThemeName, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Office2019DarkGray">
                <Setter Property="Foreground" Value="#E7EEF2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
