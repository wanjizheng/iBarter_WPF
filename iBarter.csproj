    <!-- Phase 4 (i18n): zh-TW sidecar catalogs loaded by Phase 5's
         Display getters. Items.zh-TW.csv is regenerated by
         Tools\ImportBdocodexNames (also available via the in-app
         "Import Bdocodex Names" menu item). Islands.zh-TW.csv is
         hand-curated because bdocodex has no per-island page. -->
    <Content Include="Resources\Islands.zh-TW.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Items.zh-TW.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- Phase 1 (i18n): WPF XAML resource dictionaries.  We mark them as
         <Content> with CopyToOutputDirectory=PreserveNewest so the original
         .xaml text is copied to bin (rather than getting Page-compiled
         into embedded BAML).  Loading via pack:// then parses the .xaml
         with the runtime XAML reader, which is robust against the
         clr-namespace+System.String edge case on .NET 10. -->
    <Content Include="Resources\i18n\Strings.en-US.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\i18n\Strings.zh-TW.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tessdata\eng.traineddata">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="tessdata\eng_best.traineddata">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- Phase 9 (i18n): Chinese OCR dictionaries.  Loaded by the
         local Tesseract engine when LanguageService.Current == TraditionalChinese
         and PureDM's OCR pass.  The game can render some zh-TW labels with
         simplified glyphs, so ship chi_sim alongside chi_tra and request both
         languages when both traineddata files are present. -->
    <Content Include="tessdata\chi_sim.traineddata">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="tessdata\chi_tra.traineddata">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

